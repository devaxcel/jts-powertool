[Unit]
Description=JTS PowerTool Next.js Frontend Application
After=network.target jts-powertool.service

[Service]
Type=simple
User=aleem
WorkingDirectory=/home/aleem/jts-powertool/frontend
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="BACKEND_URL=http://127.0.0.1:8000"
ExecStart=/usr/bin/npm start -- -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
